{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "pa_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "payload",
                  "type": "string",
                  "description": "JSON payload from the Code App",
                  "x-ms-dynamically-added": true,
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text"
              ]
            }
          }
        }
      },
      "actions": {
        "Start": {
          "type": "Compose",
          "inputs": "@utcNow()",
          "runAfter": {}
        },
        "Payload": {
          "type": "Compose",
          "inputs": "@json(coalesce(triggerBody()?['text'], '{}'))",
          "runAfter": {
            "Start": [
              "Succeeded"
            ]
          }
        },
        "Volume": {
          "type": "Compose",
          "inputs": "@min(max(int(coalesce(outputs('Payload')?['volume'], 500)), 1), 5000)",
          "runAfter": {
            "Payload": [
              "Succeeded"
            ]
          }
        },
        "Links": {
          "type": "Compose",
          "inputs": {
            "environmentId": "@{workflow()?['tags']?['environmentName']}",
            "flowId": "@{workflow()?['name']}",
            "runId": "@{workflow()?['run']?['name']}",
            "runUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}",
            "detailsUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/details')}"
          },
          "runAfter": {
            "Volume": [
              "Succeeded"
            ]
          }
        },
        "Create_run_row": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "CreateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "pa_benchmarkruns",
              "item/pa_name": "@{coalesce(outputs('Payload')?['correlationId'], guid())}",
              "item/pa_scenario": "UC5",
              "item/pa_variant": "MID",
              "item/pa_technique": "Apply to each + Add a new row (concurrency 50)",
              "item/pa_status": "Running",
              "item/pa_label": "@{outputs('Payload')?['label']}",
              "item/pa_volume": "@outputs('Volume')",
              "item/pa_starttime": "@outputs('Start')",
              "item/pa_runid": "@outputs('Links')?['runId']",
              "item/pa_flowid": "@outputs('Links')?['flowId']",
              "item/pa_environmentid": "@outputs('Links')?['environmentId']",
              "item/pa_runurl": "@outputs('Links')?['runUrl']",
              "item/pa_editurl": "@outputs('Links')?['detailsUrl']"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Links": [
              "Succeeded"
            ]
          }
        },
        "Respond_to_app": {
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "runid": "@{outputs('Links')?['runId']}",
              "runurl": "@{outputs('Links')?['runUrl']}",
              "rowid": "@{outputs('Create_run_row')?['body/pa_benchmarkrunid']}"
            },
            "schema": {
              "type": "object",
              "properties": {
                "runid": {
                  "title": "runId",
                  "type": "string",
                  "x-ms-dynamically-added": true
                },
                "runurl": {
                  "title": "runUrl",
                  "type": "string",
                  "x-ms-dynamically-added": true
                },
                "rowid": {
                  "title": "rowId",
                  "type": "string",
                  "x-ms-dynamically-added": true
                }
              }
            }
          },
          "runAfter": {
            "Create_run_row": [
              "Succeeded"
            ]
          }
        },
        "Work": {
          "type": "Scope",
          "actions": {
            "Create_loop": {
              "type": "Foreach",
              "foreach": "@range(0, outputs('Volume'))",
              "actions": {
                "Add_row": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "CreateRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "pa_orderimports",
                      "item/pa_name": "@{concat(outputs('Payload')?['correlationId'], '-', string(items('Create_loop')))}",
                      "item/pa_externalid": "@{concat(outputs('Payload')?['correlationId'], '-', string(items('Create_loop')))}",
                      "item/pa_region": "@{createArray('EMEA', 'AMER', 'APAC', 'LATAM', 'MEA')[mod(items('Create_loop'), 5)]}",
                      "item/pa_amount": "@if(and(equals(outputs('Payload')?['injectBadItem'], true), equals(items('Create_loop'), 0)), 'not-a-number', add(mod(mul(add(items('Create_loop'), 1), 37), 1000), div(float(mod(add(items('Create_loop'), 1), 100)), 100)))",
                      "item/pa_batchtag": "@{outputs('Payload')?['correlationId']}"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {}
                }
              },
              "runAfter": {},
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 50
                }
              }
            },
            "Verify": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "pa_orderimports",
                  "fetchXml": "<fetch aggregate=\"true\"><entity name=\"pa_orderimport\"><attribute name=\"pa_orderimportid\" alias=\"n\" aggregate=\"count\"/><attribute name=\"pa_amount\" alias=\"s\" aggregate=\"sum\"/><filter><condition attribute=\"pa_batchtag\" operator=\"eq\" value=\"@{outputs('Payload')?['correlationId']}\"/></filter></entity></fetch>"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Create_loop": [
                  "Succeeded",
                  "Failed"
                ]
              }
            },
            "Kpi": {
              "type": "Compose",
              "inputs": {
                "recordsProcessed": "@int(coalesce(first(body('Verify')?['value'])?['n'], 0))",
                "recordsRetrieved": "@0",
                "loopIterations": "@outputs('Volume')",
                "connectorCalls": "@add(outputs('Volume'), 1)",
                "actionsEstimated": "@add(17, outputs('Volume'))",
                "payloadBytes": "@0",
                "checksum": "@{concat(string(coalesce(first(body('Verify')?['value'])?['n'], 0)), '|', formatNumber(float(coalesce(first(body('Verify')?['value'])?['s'], 0)), '0.00', 'en-US'))}",
                "status": "@{if(less(int(coalesce(first(body('Verify')?['value'])?['n'], 0)), outputs('Volume')), 'Partial', 'Succeeded')}"
              },
              "runAfter": {
                "Verify": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Respond_to_app": [
              "Succeeded"
            ]
          }
        },
        "Work_errors": {
          "type": "Query",
          "inputs": {
            "from": "@result('Work')",
            "where": "@equals(item()?['status'], 'Failed')"
          },
          "runAfter": {
            "Work": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        },
        "Update_run_row": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "pa_benchmarkruns",
              "recordId": "@outputs('Create_run_row')?['body/pa_benchmarkrunid']",
              "item/pa_status": "@{coalesce(outputs('Kpi')?['status'], if(equals(actions('Work')?['status'], 'Succeeded'), 'Succeeded', 'Failed'))}",
              "item/pa_endtime": "@utcNow()",
              "item/pa_durationms": "@div(sub(ticks(utcNow()), ticks(outputs('Start'))), 10000)",
              "item/pa_recordsprocessed": "@outputs('Kpi')?['recordsProcessed']",
              "item/pa_recordsretrieved": "@outputs('Kpi')?['recordsRetrieved']",
              "item/pa_loopiterations": "@outputs('Kpi')?['loopIterations']",
              "item/pa_connectorcalls": "@outputs('Kpi')?['connectorCalls']",
              "item/pa_actionsestimated": "@outputs('Kpi')?['actionsEstimated']",
              "item/pa_payloadbytes": "@outputs('Kpi')?['payloadBytes']",
              "item/pa_resultchecksum": "@{outputs('Kpi')?['checksum']}",
              "item/pa_details": "@{string(json(concat('{\"kpi\":', string(coalesce(outputs('Kpi'), json('{}'))), ',\"payload\":', string(outputs('Payload')), ',\"links\":', string(outputs('Links')), '}')))}",
              "item/pa_error": "@{if(empty(body('Work_errors')), '', substring(string(body('Work_errors')), 0, min(length(string(body('Work_errors'))), 4000)))}"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Work_errors": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        },
        "Update_run_row_fallback": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "pa_benchmarkruns",
              "recordId": "@outputs('Create_run_row')?['body/pa_benchmarkrunid']",
              "item/pa_status": "Failed",
              "item/pa_endtime": "@utcNow()",
              "item/pa_durationms": "@div(sub(ticks(utcNow()), ticks(outputs('Start'))), 10000)",
              "item/pa_error": "@{if(empty(body('Work_errors')), 'Work failed', substring(string(body('Work_errors')), 0, min(length(string(body('Work_errors'))), 4000)))}"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Update_run_row": [
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}
