{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "pa_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "pa_sharepoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "payload",
                  "type": "string",
                  "description": "JSON payload from the Code App",
                  "x-ms-dynamically-added": true,
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text"
              ]
            }
          }
        }
      },
      "actions": {
        "Start": {
          "type": "Compose",
          "inputs": "@utcNow()",
          "runAfter": {}
        },
        "Payload": {
          "type": "Compose",
          "inputs": "@json(coalesce(triggerBody()?['text'], '{}'))",
          "runAfter": {
            "Start": [
              "Succeeded"
            ]
          }
        },
        "Volume": {
          "type": "Compose",
          "inputs": "@min(max(int(coalesce(outputs('Payload')?['volume'], 200)), 1), 5000)",
          "runAfter": {
            "Payload": [
              "Succeeded"
            ]
          }
        },
        "Links": {
          "type": "Compose",
          "inputs": {
            "environmentId": "@{workflow()?['tags']?['environmentName']}",
            "flowId": "@{workflow()?['name']}",
            "runId": "@{workflow()?['run']?['name']}",
            "runUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}",
            "detailsUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/details')}"
          },
          "runAfter": {
            "Volume": [
              "Succeeded"
            ]
          }
        },
        "Create_run_row": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "CreateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "pa_benchmarkruns",
              "item/pa_name": "@{coalesce(outputs('Payload')?['correlationId'], guid())}",
              "item/pa_scenario": "UC4",
              "item/pa_variant": "FAST",
              "item/pa_technique": "SharePoint $batch (250 per changeset, 4 batches in parallel)",
              "item/pa_status": "Running",
              "item/pa_label": "@{outputs('Payload')?['label']}",
              "item/pa_volume": "@outputs('Volume')",
              "item/pa_starttime": "@outputs('Start')",
              "item/pa_runid": "@outputs('Links')?['runId']",
              "item/pa_flowid": "@outputs('Links')?['flowId']",
              "item/pa_environmentid": "@outputs('Links')?['environmentId']",
              "item/pa_runurl": "@outputs('Links')?['runUrl']",
              "item/pa_editurl": "@outputs('Links')?['detailsUrl']"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Links": [
              "Succeeded"
            ]
          }
        },
        "Respond_to_app": {
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "runid": "@{outputs('Links')?['runId']}",
              "runurl": "@{outputs('Links')?['runUrl']}",
              "rowid": "@{outputs('Create_run_row')?['body/pa_benchmarkrunid']}"
            },
            "schema": {
              "type": "object",
              "properties": {
                "runid": {
                  "title": "runId",
                  "type": "string",
                  "x-ms-dynamically-added": true
                },
                "runurl": {
                  "title": "runUrl",
                  "type": "string",
                  "x-ms-dynamically-added": true
                },
                "rowid": {
                  "title": "rowId",
                  "type": "string",
                  "x-ms-dynamically-added": true
                }
              }
            }
          },
          "runAfter": {
            "Create_run_row": [
              "Succeeded"
            ]
          }
        },
        "Work": {
          "type": "Scope",
          "actions": {
            "CRLF": {
              "type": "Compose",
              "inputs": "@decodeUriComponent('%0D%0A')",
              "runAfter": {}
            },
            "Chunks": {
              "type": "Compose",
              "inputs": "@chunk(range(0, outputs('Volume')), min(max(int(coalesce(outputs('Payload')?['batchSize'], 250)), 1), 500))",
              "runAfter": {
                "CRLF": [
                  "Succeeded"
                ]
              }
            },
            "Batch_loop": {
              "type": "Foreach",
              "foreach": "@outputs('Chunks')",
              "actions": {
                "B_ids": {
                  "type": "Compose",
                  "inputs": {
                    "batch": "@{guid()}",
                    "cs": "@{guid()}"
                  },
                  "runAfter": {}
                },
                "B_parts": {
                  "type": "Select",
                  "inputs": {
                    "from": "@items('Batch_loop')",
                    "select": "@concat('--changeset_', outputs('B_ids')?['cs'], outputs('CRLF'), 'Content-Type: application/http', outputs('CRLF'), 'Content-Transfer-Encoding: binary', outputs('CRLF'), outputs('CRLF'), 'POST https://davidlorenzolopez.sharepoint.com/_api/web/lists(guid''0041f59a-c611-456b-8abb-b07c3cadee54'')/items HTTP/1.1', outputs('CRLF'), 'Content-Type: application/json;odata=verbose', outputs('CRLF'), outputs('CRLF'), concat('{\"__metadata\":{\"type\":\"SP.Data.OrderImportListItem\"},\"Title\":\"', concat(outputs('Payload')?['correlationId'], '-', string(item())), '\",\"Amount\":', string(add(mod(mul(add(item(), 1), 37), 1000), div(float(mod(add(item(), 1), 100)), 100))), ',\"Region\":\"', createArray('EMEA', 'AMER', 'APAC', 'LATAM', 'MEA')[mod(item(), 5)], '\",\"BatchTag\":\"', outputs('Payload')?['correlationId'], '\"}'), outputs('CRLF'), outputs('CRLF'))"
                  },
                  "runAfter": {
                    "B_ids": [
                      "Succeeded"
                    ]
                  }
                },
                "B_body": {
                  "type": "Compose",
                  "inputs": "@concat('--batch_', outputs('B_ids')?['batch'], outputs('CRLF'), 'Content-Type: multipart/mixed; boundary=\"changeset_', outputs('B_ids')?['cs'], '\"', outputs('CRLF'), 'Content-Transfer-Encoding: binary', outputs('CRLF'), outputs('CRLF'), join(body('B_parts'), ''), '--changeset_', outputs('B_ids')?['cs'], '--', outputs('CRLF'), outputs('CRLF'), '--batch_', outputs('B_ids')?['batch'], '--', outputs('CRLF'))",
                  "runAfter": {
                    "B_parts": [
                      "Succeeded"
                    ]
                  }
                },
                "B_send": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_sharepointonline",
                      "operationId": "HttpRequest",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                    },
                    "parameters": {
                      "dataset": "https://davidlorenzolopez.sharepoint.com",
                      "parameters/method": "POST",
                      "parameters/uri": "_api/$batch",
                      "parameters/headers": {
                        "Content-Type": "multipart/mixed; boundary=\"batch_@{outputs('B_ids')?['batch']}\"",
                        "Accept": "application/json;odata=verbose"
                      },
                      "parameters/body": "@outputs('B_body')"
                    },
                    "authentication": "@parameters('$authentication')"
                  },
                  "runAfter": {
                    "B_body": [
                      "Succeeded"
                    ]
                  }
                },
                "B_text": {
                  "type": "Compose",
                  "inputs": "@if(startsWith(string(body('B_send')), '{\"$content'), base64ToString(json(string(body('B_send')))?['$content']), string(body('B_send')))",
                  "runAfter": {
                    "B_send": [
                      "Succeeded",
                      "Failed"
                    ]
                  }
                }
              },
              "runAfter": {
                "Chunks": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 4
                }
              }
            },
            "Verify": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "https://davidlorenzolopez.sharepoint.com",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists(guid'0041f59a-c611-456b-8abb-b07c3cadee54')/items?$select=Amount&$filter=BatchTag eq '@{outputs('Payload')?['correlationId']}'&$top=5000",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Batch_loop": [
                  "Succeeded",
                  "Failed"
                ]
              }
            },
            "Kpi": {
              "type": "Compose",
              "inputs": {
                "recordsProcessed": "@length(body('Verify')?['value'])",
                "recordsRetrieved": "@0",
                "loopIterations": "@length(outputs('Chunks'))",
                "connectorCalls": "@add(length(outputs('Chunks')), 1)",
                "actionsEstimated": "@add(18, mul(6, length(outputs('Chunks'))))",
                "payloadBytes": "@0",
                "checksum": "@{concat(string(length(body('Verify')?['value'])), '|', formatNumber(float(xpath(xml(json(concat('{\"r\":{\"o\":', string(body('Verify')?['value']), '}}'))), 'sum(/r/o/Amount)')), '0.00', 'en-US'))}",
                "status": "@{if(less(length(body('Verify')?['value']), outputs('Volume')), 'Partial', 'Succeeded')}"
              },
              "runAfter": {
                "Verify": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Respond_to_app": [
              "Succeeded"
            ]
          }
        },
        "Work_errors": {
          "type": "Query",
          "inputs": {
            "from": "@result('Work')",
            "where": "@equals(item()?['status'], 'Failed')"
          },
          "runAfter": {
            "Work": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        },
        "Update_run_row": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "pa_benchmarkruns",
              "recordId": "@outputs('Create_run_row')?['body/pa_benchmarkrunid']",
              "item/pa_status": "@{coalesce(outputs('Kpi')?['status'], if(equals(actions('Work')?['status'], 'Succeeded'), 'Succeeded', 'Failed'))}",
              "item/pa_endtime": "@utcNow()",
              "item/pa_durationms": "@div(sub(ticks(utcNow()), ticks(outputs('Start'))), 10000)",
              "item/pa_recordsprocessed": "@outputs('Kpi')?['recordsProcessed']",
              "item/pa_recordsretrieved": "@outputs('Kpi')?['recordsRetrieved']",
              "item/pa_loopiterations": "@outputs('Kpi')?['loopIterations']",
              "item/pa_connectorcalls": "@outputs('Kpi')?['connectorCalls']",
              "item/pa_actionsestimated": "@outputs('Kpi')?['actionsEstimated']",
              "item/pa_payloadbytes": "@outputs('Kpi')?['payloadBytes']",
              "item/pa_resultchecksum": "@{outputs('Kpi')?['checksum']}",
              "item/pa_details": "@{string(json(concat('{\"kpi\":', string(coalesce(outputs('Kpi'), json('{}'))), ',\"payload\":', string(outputs('Payload')), ',\"links\":', string(outputs('Links')), '}')))}",
              "item/pa_error": "@{if(empty(body('Work_errors')), '', substring(string(body('Work_errors')), 0, min(length(string(body('Work_errors'))), 4000)))}"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Work_errors": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        },
        "Update_run_row_fallback": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "pa_benchmarkruns",
              "recordId": "@outputs('Create_run_row')?['body/pa_benchmarkrunid']",
              "item/pa_status": "Failed",
              "item/pa_endtime": "@utcNow()",
              "item/pa_durationms": "@div(sub(ticks(utcNow()), ticks(outputs('Start'))), 10000)",
              "item/pa_error": "@{if(empty(body('Work_errors')), 'Work failed', substring(string(body('Work_errors')), 0, min(length(string(body('Work_errors'))), 4000)))}"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Update_run_row": [
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}
