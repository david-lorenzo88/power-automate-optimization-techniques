{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "pa_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "pa_sharepoint"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "payload",
                  "type": "string",
                  "description": "JSON payload from the Code App",
                  "x-ms-dynamically-added": true,
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text"
              ]
            }
          }
        }
      },
      "actions": {
        "Start": {
          "type": "Compose",
          "inputs": "@utcNow()",
          "runAfter": {}
        },
        "Payload": {
          "type": "Compose",
          "inputs": "@json(coalesce(triggerBody()?['text'], '{}'))",
          "runAfter": {
            "Start": [
              "Succeeded"
            ]
          }
        },
        "Volume": {
          "type": "Compose",
          "inputs": "@min(max(int(coalesce(outputs('Payload')?['volume'], 300)), 1), 5000)",
          "runAfter": {
            "Payload": [
              "Succeeded"
            ]
          }
        },
        "Links": {
          "type": "Compose",
          "inputs": {
            "environmentId": "@{workflow()?['tags']?['environmentName']}",
            "flowId": "@{workflow()?['name']}",
            "runId": "@{workflow()?['run']?['name']}",
            "runUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}",
            "detailsUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/details')}"
          },
          "runAfter": {
            "Volume": [
              "Succeeded"
            ]
          }
        },
        "Create_run_row": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "CreateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "pa_benchmarkruns",
              "item/pa_name": "@{coalesce(outputs('Payload')?['correlationId'], guid())}",
              "item/pa_scenario": "UC3",
              "item/pa_variant": "SLOW",
              "item/pa_technique": "Nested loops + Increment / Set variable per region",
              "item/pa_status": "Running",
              "item/pa_label": "@{outputs('Payload')?['label']}",
              "item/pa_volume": "@outputs('Volume')",
              "item/pa_starttime": "@outputs('Start')",
              "item/pa_runid": "@outputs('Links')?['runId']",
              "item/pa_flowid": "@outputs('Links')?['flowId']",
              "item/pa_environmentid": "@outputs('Links')?['environmentId']",
              "item/pa_runurl": "@outputs('Links')?['runUrl']",
              "item/pa_editurl": "@outputs('Links')?['detailsUrl']"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Links": [
              "Succeeded"
            ]
          }
        },
        "Respond_to_app": {
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "runid": "@{outputs('Links')?['runId']}",
              "runurl": "@{outputs('Links')?['runUrl']}",
              "rowid": "@{outputs('Create_run_row')?['body/pa_benchmarkrunid']}"
            },
            "schema": {
              "type": "object",
              "properties": {
                "runid": {
                  "title": "runId",
                  "type": "string",
                  "x-ms-dynamically-added": true
                },
                "runurl": {
                  "title": "runUrl",
                  "type": "string",
                  "x-ms-dynamically-added": true
                },
                "rowid": {
                  "title": "rowId",
                  "type": "string",
                  "x-ms-dynamically-added": true
                }
              }
            }
          },
          "runAfter": {
            "Create_run_row": [
              "Succeeded"
            ]
          }
        },
        "Init_Results": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Results",
                "type": "array",
                "value": []
              }
            ]
          },
          "runAfter": {
            "Respond_to_app": [
              "Succeeded"
            ]
          }
        },
        "Init_Cnt": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Cnt",
                "type": "integer",
                "value": 0
              }
            ]
          },
          "runAfter": {
            "Init_Results": [
              "Succeeded"
            ]
          }
        },
        "Init_Sum": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Sum",
                "type": "float",
                "value": 0
              }
            ]
          },
          "runAfter": {
            "Init_Cnt": [
              "Succeeded"
            ]
          }
        },
        "Init_MaxAmt": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "MaxAmt",
                "type": "float",
                "value": -1
              }
            ]
          },
          "runAfter": {
            "Init_Sum": [
              "Succeeded"
            ]
          }
        },
        "Init_MinAmt": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "MinAmt",
                "type": "float",
                "value": 1000000
              }
            ]
          },
          "runAfter": {
            "Init_MaxAmt": [
              "Succeeded"
            ]
          }
        },
        "Work": {
          "type": "Scope",
          "actions": {
            "Get_orders": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_sharepointonline",
                  "operationId": "HttpRequest",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
                },
                "parameters": {
                  "dataset": "https://davidlorenzolopez.sharepoint.com",
                  "parameters/method": "GET",
                  "parameters/uri": "_api/web/lists(guid'9dfbe96c-ae54-4ede-ab70-759f66b603fa')/items?$select=Id,Title,CustCode,Region,Status,Amount&$filter=Id le @{outputs('Volume')}&$orderby=Id&$top=5000",
                  "parameters/headers": {
                    "Accept": "application/json;odata=nometadata"
                  }
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Region_loop": {
              "type": "Foreach",
              "foreach": "@createArray('EMEA', 'AMER', 'APAC', 'LATAM', 'MEA')",
              "actions": {
                "Reset_cnt": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "Cnt",
                    "value": 0
                  },
                  "runAfter": {}
                },
                "Reset_sum": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "Sum",
                    "value": 0
                  },
                  "runAfter": {
                    "Reset_cnt": [
                      "Succeeded"
                    ]
                  }
                },
                "Reset_max": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "MaxAmt",
                    "value": -1
                  },
                  "runAfter": {
                    "Reset_sum": [
                      "Succeeded"
                    ]
                  }
                },
                "Reset_min": {
                  "type": "SetVariable",
                  "inputs": {
                    "name": "MinAmt",
                    "value": 1000000
                  },
                  "runAfter": {
                    "Reset_max": [
                      "Succeeded"
                    ]
                  }
                },
                "Order_loop": {
                  "type": "Foreach",
                  "foreach": "@body('Get_orders')?['value']",
                  "actions": {
                    "In_region": {
                      "type": "If",
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@items('Order_loop')?['Region']",
                              "@items('Region_loop')"
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "Add_count": {
                          "type": "IncrementVariable",
                          "inputs": {
                            "name": "Cnt",
                            "value": 1
                          },
                          "runAfter": {}
                        },
                        "Add_sum": {
                          "type": "IncrementVariable",
                          "inputs": {
                            "name": "Sum",
                            "value": "@items('Order_loop')?['Amount']"
                          },
                          "runAfter": {
                            "Add_count": [
                              "Succeeded"
                            ]
                          }
                        },
                        "Check_max": {
                          "type": "If",
                          "expression": {
                            "and": [
                              {
                                "greater": [
                                  "@float(items('Order_loop')?['Amount'])",
                                  "@variables('MaxAmt')"
                                ]
                              }
                            ]
                          },
                          "actions": {
                            "Set_max": {
                              "type": "SetVariable",
                              "inputs": {
                                "name": "MaxAmt",
                                "value": "@float(items('Order_loop')?['Amount'])"
                              },
                              "runAfter": {}
                            }
                          },
                          "else": {
                            "actions": {}
                          },
                          "runAfter": {
                            "Add_sum": [
                              "Succeeded"
                            ]
                          }
                        },
                        "Check_min": {
                          "type": "If",
                          "expression": {
                            "and": [
                              {
                                "less": [
                                  "@float(items('Order_loop')?['Amount'])",
                                  "@variables('MinAmt')"
                                ]
                              }
                            ]
                          },
                          "actions": {
                            "Set_min": {
                              "type": "SetVariable",
                              "inputs": {
                                "name": "MinAmt",
                                "value": "@float(items('Order_loop')?['Amount'])"
                              },
                              "runAfter": {}
                            }
                          },
                          "else": {
                            "actions": {}
                          },
                          "runAfter": {
                            "Check_max": [
                              "Succeeded"
                            ]
                          }
                        }
                      },
                      "else": {
                        "actions": {}
                      },
                      "runAfter": {}
                    }
                  },
                  "runAfter": {
                    "Reset_min": [
                      "Succeeded"
                    ]
                  },
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 1
                    }
                  }
                },
                "Has_orders": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "greater": [
                          "@variables('Cnt')",
                          0
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Append_region": {
                      "type": "AppendToArrayVariable",
                      "inputs": {
                        "name": "Results",
                        "value": {
                          "region": "@items('Region_loop')",
                          "count": "@variables('Cnt')",
                          "sum": "@variables('Sum')",
                          "min": "@variables('MinAmt')",
                          "max": "@variables('MaxAmt')"
                        }
                      },
                      "runAfter": {}
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "runAfter": {
                    "Order_loop": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runAfter": {
                "Get_orders": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "concurrency": {
                  "repetitions": 1
                }
              }
            },
            "Summary": {
              "type": "Select",
              "inputs": {
                "from": "@sort(variables('Results'), 'region')",
                "select": "@concat(item()?['region'], ':', string(item()?['count']), ':', formatNumber(float(item()?['sum']), '0.00', 'en-US'), ':', formatNumber(float(item()?['min']), '0.00', 'en-US'), ':', formatNumber(float(item()?['max']), '0.00', 'en-US'))"
              },
              "runAfter": {
                "Region_loop": [
                  "Succeeded"
                ]
              }
            },
            "Kpi": {
              "type": "Compose",
              "inputs": {
                "recordsProcessed": "@length(body('Get_orders')?['value'])",
                "recordsRetrieved": "@length(body('Get_orders')?['value'])",
                "loopIterations": "@add(5, mul(5, length(body('Get_orders')?['value'])))",
                "connectorCalls": "@1",
                "actionsEstimated": "@add(47, mul(9, length(body('Get_orders')?['value'])))",
                "payloadBytes": "@length(string(body('Get_orders')))",
                "checksum": "@{join(body('Summary'), ';')}"
              },
              "runAfter": {
                "Summary": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Init_MinAmt": [
              "Succeeded"
            ]
          }
        },
        "Work_errors": {
          "type": "Query",
          "inputs": {
            "from": "@result('Work')",
            "where": "@equals(item()?['status'], 'Failed')"
          },
          "runAfter": {
            "Work": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        },
        "Update_run_row": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "pa_benchmarkruns",
              "recordId": "@outputs('Create_run_row')?['body/pa_benchmarkrunid']",
              "item/pa_status": "@{if(equals(actions('Work')?['status'], 'Succeeded'), coalesce(outputs('Kpi')?['status'], 'Succeeded'), 'Failed')}",
              "item/pa_endtime": "@utcNow()",
              "item/pa_durationms": "@div(sub(ticks(utcNow()), ticks(outputs('Start'))), 10000)",
              "item/pa_recordsprocessed": "@outputs('Kpi')?['recordsProcessed']",
              "item/pa_recordsretrieved": "@outputs('Kpi')?['recordsRetrieved']",
              "item/pa_loopiterations": "@outputs('Kpi')?['loopIterations']",
              "item/pa_connectorcalls": "@outputs('Kpi')?['connectorCalls']",
              "item/pa_actionsestimated": "@outputs('Kpi')?['actionsEstimated']",
              "item/pa_payloadbytes": "@outputs('Kpi')?['payloadBytes']",
              "item/pa_resultchecksum": "@{outputs('Kpi')?['checksum']}",
              "item/pa_details": "@{string(json(concat('{\"kpi\":', string(coalesce(outputs('Kpi'), json('{}'))), ',\"payload\":', string(outputs('Payload')), ',\"links\":', string(outputs('Links')), '}')))}",
              "item/pa_error": "@{if(empty(body('Work_errors')), '', substring(string(body('Work_errors')), 0, min(length(string(body('Work_errors'))), 4000)))}"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Work_errors": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        },
        "Update_run_row_fallback": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "pa_benchmarkruns",
              "recordId": "@outputs('Create_run_row')?['body/pa_benchmarkrunid']",
              "item/pa_status": "Failed",
              "item/pa_endtime": "@utcNow()",
              "item/pa_durationms": "@div(sub(ticks(utcNow()), ticks(outputs('Start'))), 10000)",
              "item/pa_error": "@{if(empty(body('Work_errors')), 'Work failed', substring(string(body('Work_errors')), 0, min(length(string(body('Work_errors'))), 4000)))}"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Update_run_row": [
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}
