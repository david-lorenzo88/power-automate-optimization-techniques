{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "pa_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_webcontents": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "pa_httpdataverse"
        },
        "api": {
          "name": "shared_webcontents"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "payload",
                  "type": "string",
                  "description": "JSON payload from the Code App",
                  "x-ms-dynamically-added": true,
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text"
              ]
            }
          }
        }
      },
      "actions": {
        "Start": {
          "type": "Compose",
          "inputs": "@utcNow()",
          "runAfter": {}
        },
        "Payload": {
          "type": "Compose",
          "inputs": "@json(coalesce(triggerBody()?['text'], '{}'))",
          "runAfter": {
            "Start": [
              "Succeeded"
            ]
          }
        },
        "Volume": {
          "type": "Compose",
          "inputs": "@min(max(int(coalesce(outputs('Payload')?['volume'], 20000)), 1), 20000)",
          "runAfter": {
            "Payload": [
              "Succeeded"
            ]
          }
        },
        "Links": {
          "type": "Compose",
          "inputs": {
            "environmentId": "@{workflow()?['tags']?['environmentName']}",
            "flowId": "@{workflow()?['name']}",
            "runId": "@{workflow()?['run']?['name']}",
            "runUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/runs/', workflow()?['run']?['name'])}",
            "detailsUrl": "@{concat('https://make.powerautomate.com/environments/', workflow()?['tags']?['environmentName'], '/flows/', workflow()?['name'], '/details')}"
          },
          "runAfter": {
            "Volume": [
              "Succeeded"
            ]
          }
        },
        "Create_run_row": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "CreateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "pa_benchmarkruns",
              "item/pa_name": "@{coalesce(outputs('Payload')?['correlationId'], guid())}",
              "item/pa_scenario": "ADMIN",
              "item/pa_variant": "SEED-DV",
              "item/pa_technique": "Seed pa_order with CreateMultiple (1,000 per call, 4 in parallel)",
              "item/pa_status": "Running",
              "item/pa_label": "@{outputs('Payload')?['label']}",
              "item/pa_volume": "@outputs('Volume')",
              "item/pa_starttime": "@outputs('Start')",
              "item/pa_runid": "@outputs('Links')?['runId']",
              "item/pa_flowid": "@outputs('Links')?['flowId']",
              "item/pa_environmentid": "@outputs('Links')?['environmentId']",
              "item/pa_runurl": "@outputs('Links')?['runUrl']",
              "item/pa_editurl": "@outputs('Links')?['detailsUrl']"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Links": [
              "Succeeded"
            ]
          }
        },
        "Respond_to_app": {
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "runid": "@{outputs('Links')?['runId']}",
              "runurl": "@{outputs('Links')?['runUrl']}",
              "rowid": "@{outputs('Create_run_row')?['body/pa_benchmarkrunid']}"
            },
            "schema": {
              "type": "object",
              "properties": {
                "runid": {
                  "title": "runId",
                  "type": "string",
                  "x-ms-dynamically-added": true
                },
                "runurl": {
                  "title": "runUrl",
                  "type": "string",
                  "x-ms-dynamically-added": true
                },
                "rowid": {
                  "title": "rowId",
                  "type": "string",
                  "x-ms-dynamically-added": true
                }
              }
            }
          },
          "runAfter": {
            "Create_run_row": [
              "Succeeded"
            ]
          }
        },
        "Work": {
          "type": "Scope",
          "actions": {
            "Count_rows": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "pa_orders",
                  "fetchXml": "<fetch aggregate=\"true\"><entity name=\"pa_order\"><attribute name=\"pa_orderid\" alias=\"n\" aggregate=\"count\"/></entity></fetch>"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {}
            },
            "Seed": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@int(coalesce(first(body('Count_rows')?['value'])?['n'], 0))",
                      0
                    ]
                  }
                ]
              },
              "actions": {
                "Seed_loop": {
                  "type": "Foreach",
                  "foreach": "@chunk(range(1, outputs('Volume')), 1000)",
                  "actions": {
                    "Targets": {
                      "type": "Select",
                      "inputs": {
                        "from": "@items('Seed_loop')",
                        "select": "@concat('{\"@odata.type\":\"Microsoft.Dynamics.CRM.pa_order\",\"pa_name\":\"', concat('O', substring(string(add(100000, item())), 1, 5)), '\",\"pa_customerid\":\"', concat('C', substring(string(add(10000, add(mod(sub(item(), 1), 2000), 1))), 1, 4)), '\",\"pa_region\":\"', createArray('EMEA', 'AMER', 'APAC', 'LATAM', 'MEA')[mod(item(), 5)], '\",\"pa_status\":\"', if(less(mod(mul(item(), 7), 20), 3), 'Open', if(less(mod(mul(item(), 7), 20), 13), 'Closed', if(less(mod(mul(item(), 7), 20), 18), 'Pending', 'Approved'))), '\",\"pa_amount\":', string(add(mod(mul(item(), 37), 1000), div(float(mod(item(), 100)), 100))), ',\"pa_orderdate\":\"', addDays('2026-01-01', mod(item(), 300), 'yyyy-MM-dd'), '\"}')"
                      },
                      "runAfter": {}
                    },
                    "Create_multiple": {
                      "type": "OpenApiConnection",
                      "inputs": {
                        "host": {
                          "connectionName": "shared_webcontents",
                          "operationId": "InvokeHttp",
                          "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents"
                        },
                        "parameters": {
                          "request/method": "POST",
                          "request/url": "https://premium-us.crm.dynamics.com/api/data/v9.2/pa_orders/Microsoft.Dynamics.CRM.CreateMultiple",
                          "request/headers": {
                            "Content-Type": "application/json; charset=utf-8",
                            "Accept": "application/json",
                            "OData-Version": "4.0",
                            "OData-MaxVersion": "4.0"
                          },
                          "request/body": "@{concat('{\"Targets\":[', join(body('Targets'), ','), ']}')}"
                        },
                        "authentication": "@parameters('$authentication')"
                      },
                      "runAfter": {
                        "Targets": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "runAfter": {},
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 4
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "Count_rows": [
                  "Succeeded"
                ]
              }
            },
            "Final_count": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "pa_orders",
                  "fetchXml": "<fetch aggregate=\"true\"><entity name=\"pa_order\"><attribute name=\"pa_orderid\" alias=\"n\" aggregate=\"count\"/></entity></fetch>"
                },
                "authentication": "@parameters('$authentication')"
              },
              "runAfter": {
                "Seed": [
                  "Succeeded",
                  "Failed",
                  "Skipped",
                  "TimedOut"
                ]
              }
            },
            "Kpi": {
              "type": "Compose",
              "inputs": {
                "recordsProcessed": "@int(coalesce(first(body('Final_count')?['value'])?['n'], 0))",
                "recordsRetrieved": "@0",
                "loopIterations": "@0",
                "connectorCalls": "@add(2, div(add(outputs('Volume'), 999), 1000))",
                "actionsEstimated": "@20",
                "payloadBytes": "@0",
                "checksum": "@{string(coalesce(first(body('Final_count')?['value'])?['n'], 0))}"
              },
              "runAfter": {
                "Final_count": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Respond_to_app": [
              "Succeeded"
            ]
          }
        },
        "Work_errors": {
          "type": "Query",
          "inputs": {
            "from": "@result('Work')",
            "where": "@equals(item()?['status'], 'Failed')"
          },
          "runAfter": {
            "Work": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        },
        "Update_run_row": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "pa_benchmarkruns",
              "recordId": "@outputs('Create_run_row')?['body/pa_benchmarkrunid']",
              "item/pa_status": "@{coalesce(outputs('Kpi')?['status'], if(equals(actions('Work')?['status'], 'Succeeded'), 'Succeeded', 'Failed'))}",
              "item/pa_endtime": "@utcNow()",
              "item/pa_durationms": "@div(sub(ticks(utcNow()), ticks(outputs('Start'))), 10000)",
              "item/pa_recordsprocessed": "@outputs('Kpi')?['recordsProcessed']",
              "item/pa_recordsretrieved": "@outputs('Kpi')?['recordsRetrieved']",
              "item/pa_loopiterations": "@outputs('Kpi')?['loopIterations']",
              "item/pa_connectorcalls": "@outputs('Kpi')?['connectorCalls']",
              "item/pa_actionsestimated": "@outputs('Kpi')?['actionsEstimated']",
              "item/pa_payloadbytes": "@outputs('Kpi')?['payloadBytes']",
              "item/pa_resultchecksum": "@{outputs('Kpi')?['checksum']}",
              "item/pa_details": "@{string(json(concat('{\"kpi\":', string(coalesce(outputs('Kpi'), json('{}'))), ',\"payload\":', string(outputs('Payload')), ',\"links\":', string(outputs('Links')), '}')))}",
              "item/pa_error": "@{if(empty(body('Work_errors')), '', substring(string(body('Work_errors')), 0, min(length(string(body('Work_errors'))), 4000)))}"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Work_errors": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        },
        "Update_run_row_fallback": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "pa_benchmarkruns",
              "recordId": "@outputs('Create_run_row')?['body/pa_benchmarkrunid']",
              "item/pa_status": "Failed",
              "item/pa_endtime": "@utcNow()",
              "item/pa_durationms": "@div(sub(ticks(utcNow()), ticks(outputs('Start'))), 10000)",
              "item/pa_error": "@{if(empty(body('Work_errors')), 'Work failed', substring(string(body('Work_errors')), 0, min(length(string(body('Work_errors'))), 4000)))}"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runAfter": {
            "Update_run_row": [
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}
